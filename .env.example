# =====================================================================
# Deal Finder Environment Configuration Example
# Copy this file to .env and configure your real secrets.
# NEVER commit .env to source control!
# =====================================================================

# Gemini API Key (Required for Phase 1 AI deal & spec auditing)
GEMINI_API_KEY=your_gemini_api_key_here
# Override only when your Gemini project uses a different supported model.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_AUDIT_CHUNK_SIZE=20
GEMINI_AUDIT_TIMEOUT_SECONDS=30
GEMINI_TIMEOUT_RETRIES=1

# Google Sheets Configuration
# The ID from your Google Sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your_google_spreadsheet_id_here

# Path to Google Cloud Service Account credentials JSON
SERVICE_ACCOUNT_FILE=service_account.json

# Scraper Timing and Throttling
REQUEST_DELAY_SECONDS=5
DEFAULT_TIMEOUT_SECONDS=15.0
