# Python runner: GitHub Actions repository secrets (enter real values privately).
# The workflow supplies SCAN_RUN_ID for each Scan Now request; do not hardcode it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
ALLOWED_USER_ID=749743db-c366-47c9-9373-bec966857b32

# Next.js / Vercel: public browser configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Next.js / Vercel: server-only configuration, Production environment only.
# SUPABASE_SECRET_KEY above is also required by Vercel; never use NEXT_PUBLIC_.
ALLOWED_USER_EMAIL=dealfinder0322@gmail.com
GITHUB_ACTIONS_TOKEN=
GITHUB_REPOSITORY=LuckyProgramme/carousell_listing_scraper
GITHUB_WORKFLOW_FILE=scan.yml
GITHUB_WORKFLOW_REF=main
STALE_QUEUED_SCAN_MINUTES=15
# Local development origin only. In Vercel set the exact https production origin,
# without a trailing slash, path, query, or fragment. Do not enable preview scans.
FRONTEND_ORIGIN=http://localhost:3000

# Optional Python defaults; these do not set a whole-scan timeout or job retry.
SUPABASE_TIMEOUT_SECONDS=20
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_AUDIT_CHUNK_SIZE=20
GEMINI_AUDIT_TIMEOUT_SECONDS=30
GEMINI_TIMEOUT_RETRIES=1
REQUEST_DELAY_SECONDS=5
DEFAULT_TIMEOUT_SECONDS=15.0
DEAL_FINDER_LOG_DIR=logs

# Temporary local Supabase CLI fallback only; never needed by the hosted workflow.
# SUPABASE_OWNER_ID=749743db-c366-47c9-9373-bec966857b32
# Cloud Run and Google Sheets configuration are not part of the supported rollout.
# See docs/vercel-github-actions.md for exact provider settings and recovery gates.
